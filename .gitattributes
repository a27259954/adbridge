# Normalise line endings; Windows checkouts still get LF in the repo.
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.jpg binary

# Generated code: collapsed in diffs and excluded from language stats
frontend/bindings/** linguist-generated=true
go.sum linguist-generated=true
frontend/package-lock.json linguist-generated=true
